    },
    "optimizer_rule": "For immediate purchase recommendations use instant_buy_coins. For rough price/value comparisons use midpoint_reference_coins. Never present the midpoint as a 7d/30d historical average.",
    "wide_spread_rule": "If spread_pct_of_midpoint >= 20, flag PRICE_VOLATILE and prefer live refresh/order pricing over the dated midpoint."
  },
